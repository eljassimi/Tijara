# PostgreSQL
DATABASE_URL="postgresql://tijara:tijara@localhost:5434/tijara?schema=public"

# Session signing (HS256 JWT wrapping a database session id — not a pure JWT auth)
AUTH_SECRET="replace-with-a-long-random-value"
AUTH_URL="http://localhost:3000"
# Required behind a reverse proxy so authentication rate limits use the real client IP.
TRUST_PROXY="true"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Localhost-only escape hatch for testing `next start`; never enable on a public URL.
ALLOW_INSECURE_LOCAL_AUTH="false"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# S3-compatible object storage
MEDIA_STORAGE_DRIVER="s3"
# For local development without S3, set MEDIA_STORAGE_DRIVER="local".
# MEDIA_LOCAL_ROOT=".data/uploads"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tijara"
S3_ACCESS_KEY_ID="minio"
S3_SECRET_ACCESS_KEY="minio-secret"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL="http://localhost:9000/tijara"

# Email (Mailpit locally)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Tijara <noreply@tijara.local>"

# Public contact details (do not invent production values)
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_ADDRESS=""
