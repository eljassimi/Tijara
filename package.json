{
  "name": "tijara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "TZ=UTC next dev --turbopack",
    "build": "TZ=UTC next build",
    "start": "TZ=UTC next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "TZ=UTC tsx prisma/seed.ts",
    "catalog:sync": "node --import tsx prisma/sync-catalog.ts",
    "cities:sync": "node --import tsx prisma/sync-cities.ts",
    "format": "prettier --write .",
    "worker": "TZ=UTC tsx src/jobs/worker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "latest",
    "@aws-sdk/client-s3": "3.922.0",
    "@hookform/resolvers": "latest",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-slot": "latest",
    "@react-pdf/renderer": "latest",
    "@tanstack/react-table": "latest",
    "argon2": "latest",
    "bullmq": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dotenv": "^18.0.9",
    "exceljs": "latest",
    "framer-motion": "latest",
    "ioredis": "6.0.0",
    "jose": "^6.2.14",
    "jszip": "3.10.2",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "beta",
    "next-intl": "latest",
    "nodemailer": "^8.0.5",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "^7.10.1",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": "prettier --write"
  }
}
